<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (iisnode) hosting for the SAP Email-Approval service.
  IIS terminates HTTPS (bind the certificate on the site) and forwards requests
  to this Node app, which serves plain HTTP. Requires the iisnode module.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- iisnode's own debug UI -->
        <rule name="iisnode-debug" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>
        <!-- All application traffic is handled by the Node entry point -->
        <rule name="app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Do not serve source, secrets, deps or certs over HTTP -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="test" />
          <add segment="certs" />
          <add segment="iisnode" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!--
      nodeProcessCountPerApplication=1 is REQUIRED: the queue worker runs one
      in-process poll loop with in-memory de-duplication. More than one Node
      process would poll SAP concurrently and send duplicate approval emails.
    -->
    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      devErrorsEnabled="false" />
  </system.webServer>
</configuration>
