<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the SAP Email-Approval service.

  This single site serves two companies by host name:
    - sapapproval.minalspecialities.com  -> Node app (MSPL) on http://localhost:3001
    - sapapproval.matangiindustries.com  -> Node app (MILLP) on http://localhost:3000
  Both Node apps run standalone (npm start) and serve plain HTTP; IIS terminates
  HTTPS (bind each host's certificate on the site) and forwards to the matching
  app by the {HTTP_HOST} of the request.

  The app is served under a base path (BASE_PATH, default /salesorder), so its
  public URLs look like https://<host>/salesorder/... The rewrite preserves the
  full path ({R:1}), so /salesorder/... reaches the Node app unchanged — no path
  rewriting is required here.

  REQUIRES these IIS modules installed on the server:
    - URL Rewrite   (https://www.iis.net/downloads/microsoft/url-rewrite)
    - Application Request Routing / ARR  (enables proxying to an external URL)
  And in IIS Manager -> (server node) -> Application Request Routing Cache
    -> Server Proxy Settings -> tick "Enable proxy".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Send any http request to https -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- MSPL host -> Node app on port 3001 -->
        <rule name="ReverseProxyToNodeMSPL" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^sapapproval\.minalspecialities\.com$" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>

        <!-- Everything else (Matangi host) -> Node app on port 3000 -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Pass the original client IP through to the app (it uses trust proxy) -->
    <proxy xdns="true" preserveHostHeader="true" />
  </system.webServer>
</configuration>
