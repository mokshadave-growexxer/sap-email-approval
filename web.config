<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the SAP Email-Approval service.

  The Node app runs standalone (npm start) on http://localhost:3000 and serves
  plain HTTP. IIS terminates HTTPS for https://sapapproval.matangiindustries.com
  (bind the certificate on the site) and forwards all traffic to the Node app.

  REQUIRES these IIS modules installed on the server:
    - URL Rewrite   (https://www.iis.net/downloads/microsoft/url-rewrite)
    - Application Request Routing / ARR  (enables proxying to an external URL)
  And in IIS Manager -> (server node) -> Application Request Routing Cache
    -> Server Proxy Settings -> tick "Enable proxy".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Send any http request to https -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Forward everything else to the Node app on port 3000 -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Pass the original client IP through to the app (it uses trust proxy) -->
    <proxy xdns="true" preserveHostHeader="true" />
  </system.webServer>
</configuration>
